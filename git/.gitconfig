[user]
	name = Fabian Thorsen
	email = fabian.thorsen@tetdigital.no
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICbQVqWkh590dDEtcb9WPrbBKDpDUUeB++MaIHdnAPY7
[url "git@github.com:"]
	insteadOf = https://github.com/

[init]
	# new repos start on main, not master
	defaultBranch = main
[push]
	# first `git push` on a new branch sets the upstream automatically
	autoSetupRemote = true
[fetch]
	# drop references to branches deleted on the remote
	prune = true
[pull]
	# rebase local commits instead of creating merge commits
	rebase = true
[rebase]
	# stash uncommitted changes before rebasing, restore them after
	autoStash = true
[merge]
	# conflict markers also show the original text
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[core]
	pager = delta
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	theme = Catppuccin Macchiato
[rerere]
	# remember conflict resolutions and reuse them
	enabled = true
[branch]
	# most recently used branches first
	sort = -committerdate
[commit]
	# show the diff in the editor while writing the message
	verbose = true
	gpgsign = true
[help]
	autocorrect = prompt

[alias]
	st = status -sb
	lg = log --graph --oneline --decorate --all
	amend = commit --amend --no-edit
	# undo the last commit, keep its changes staged
	undo = reset --soft HEAD~1
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
